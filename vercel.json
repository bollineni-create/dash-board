{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:provider(visor|autodev)/:path*",
      "destination": "/api/relay?provider=:provider&path=:path*"
    },
    {
      "source": "/ballast/api/:route*",
      "destination": "/api/ballast?route=:route*"
    }
  ],
  "headers": [
    {
      "source": "/:app/(js|css|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/ballast.js": {
      "maxDuration": 120
    }
  }
}
